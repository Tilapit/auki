# Copy to .env.local and fill in. Nothing here is needed before M2.
# openrouteservice key for walking times and routes (M5). Server only.
ORS_API_KEY=
# Contact address sent in the User-Agent to Overpass and Nominatim (M2).
CONTACT_EMAIL=
# MapLibre style URL (M4). Defaults to OpenFreeMap when empty.
MAP_STYLE_URL=
