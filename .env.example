# Copy to .env.local and fill in. Secrets live only there, never in the repository.

# Contact address sent in the User-Agent to Nominatim (place search, M1) and to Overpass
# (the nightly pipeline, M2). Their usage policies ask for one. Without it place search
# answers "not available" instead of calling Nominatim unidentified.
CONTACT_EMAIL=

# openrouteservice key for walking times and routes (M5). Server only.
ORS_API_KEY=

# Where the pharmacy tiles are published (M2). The app serves them under /tiles, and the
# pipeline reads the last run from there. Empty in development: the tiles then come from
# `npm run data:serve` on this machine.
TILES_ORIGIN=

# Visitors' reports (PLAN.md 7.10), kept in a Supabase project. Server only: the secret key
# never reaches the browser, and the browser never talks to the database. Without the first
# two, /api/report answers 503 and the app offers no report and shows none.
# SUPABASE_DB_URL is the Postgres connection string, percent-encoded, used only by
# `npm run db:push` to apply supabase/migrations/. The app itself never reads it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Where the map's vector tiles come from, as a TileJSON address (M4). Empty: OpenFreeMap.
# The style is our own, so another host with the OpenMapTiles schema works by changing this
# one value. It is public by nature: the browser fetches from it, and the
# Content-Security-Policy allows that host and no other.
NEXT_PUBLIC_MAP_TILES_URL=
