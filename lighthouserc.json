{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3100/fi"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": ["error", { "maxNumericValue": 189440, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
